{
    "presets": [["module:@react-native/babel-preset", {"useTransformReactJSXExperimental": true}], "nativewind/babel"],
    "plugins": [
        ["module:react-native-dotenv", {
            "safe": true,
            "allowUndefined": false,
            "path": ".env",
            "moduleName": "@env"
        }],
        [
            "module-resolver",
            {
                "alias": {
                    "@breeztech/react-native-breez-sdk": "./modules/breez-legacy-shim.ts",
                    "react-native-qrcode-styled": "./modules/qrcode-shim.tsx",
                    "crypto": "react-native-quick-crypto",
                    "stream": "stream-browserify",
                    "buffer": "@craftzdog/react-native-buffer"
                }
            }
        ],
        [
            "react-native-reanimated/plugin",
            {
                "globals": ["__scanCodes"]
            }
        ]
    ],
    "env": {
        "production": {
          "plugins": ["transform-remove-console"]
        }
    }
}
